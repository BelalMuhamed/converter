<Window x:Class="AbsaConverterTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CRDB Farmers" 
        Height="600" Width="850" 
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#F9FAFB">

    <!-- =================== STYLES =================== -->
    <Window.Resources>
        <!-- Primary Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E3A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Button -->
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Title Bar Button -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E3A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- =================== LAYOUT =================== -->
    <Border CornerRadius="12" BorderBrush="#DDD" BorderThickness="1" Background="White">
        <DockPanel>

            <!-- Custom Title Bar -->
            <DockPanel DockPanel.Dock="Top" Background="#2563EB" Height="48" MouseDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="—" Style="{StaticResource TitleBarButtonStyle}" Click="Minimize_Click" ToolTip="Minimize"/>
                    <Button Content="▢" Style="{StaticResource TitleBarButtonStyle}" Click="Maximize_Click" ToolTip="Maximize/Restore"/>
                    <Button Content="✕" Style="{StaticResource TitleBarButtonStyle}" Background="Red" Click="Close_Click" ToolTip="Close"/>
                </StackPanel>

                <TextBlock Text="ABSA Tool v02" 
                           Foreground="White" 
                           FontWeight="Bold" 
                           FontSize="18" 
                           VerticalAlignment="Center"
                           Margin="16,0"
                           DockPanel.Dock="Left" />
            </DockPanel>

            <!-- Footer -->
            <Border DockPanel.Dock="Bottom" Background="#F3F4F6" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="/Images/mdpLogo.png" Height="36" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" 
                               FontSize="12" Foreground="#6B7280">
                        © Developed by Factory Development Team MDP ©
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Row 0: P3 -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: PIN -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 2: References -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 3: Process Button -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 4: Status -->
                    <RowDefinition Height="*"/>
                    <!-- Row 5: ListBoxes -->
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ================= P3 File ================= -->
                <Button Grid.Row="0" Grid.Column="0" x:Name="chooseFolder"
                        Content="📂 Choose Folder" 
                        Style="{StaticResource AccentButtonStyle}"
                        Margin="5,5,5,0" Height="17" VerticalAlignment="Top" Click="ChooseFolder_Click"/>

                <TextBlock Grid.Row="0" Grid.Column="1" 
                           x:Name="SelectedFileNameTextBlock" 
                           VerticalAlignment="Center" 
                           Margin="5" TextWrapping="Wrap" 
                           Foreground="Green"/>





                <!-- ================= Process Button ================= -->
                <Button Grid.Row="3" x:Name="processButton" 
                        Grid.Column="1" 
                        Content="⚙ Process Files" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="167,20,0,0"  
                        Padding="12,6"
                        HorizontalAlignment="Left" Height="19" VerticalAlignment="Top" Click="processButton_Click" />

                <!-- ================= Status ================= -->
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" 
                            Margin="12" HorizontalAlignment="Center" Width="420">
                    <Label x:Name="ErrorLabel" Foreground="Red" Visibility="Collapsed" HorizontalAlignment="Center"  />
                    <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Height="20" Visibility="Collapsed" Margin="0,12"/>
                    <Label x:Name="SuccessLabel" Foreground="Green" Visibility="Collapsed" 
                           Content="Process Completed Successfully!" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- ================= Three ListBoxes ================= -->
                <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" 
                            Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">

                    <!-- First ListBox -->
                    <StackPanel Margin="10" Visibility="Hidden" x:Name="FailedP3Panel">
                        <TextBlock Text="Failed P3 Files" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                        <ListBox x:Name="ErrorsListBox" Width="200" Height="150" Foreground="Red" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Second ListBox -->
                    <StackPanel Margin="10" Visibility="Hidden" x:Name="FailedPINPanel">
                        <TextBlock Text="Failed PIN Files" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                        <ListBox x:Name="WarningsListBox" Width="200" Height="150" Foreground="Red" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Third ListBox -->
                    <StackPanel Margin="10" Visibility="Hidden" x:Name="FailedReferencesPanel">
                        <TextBlock Text="Failed References Files" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                        <ListBox x:Name="InfoListBox" Width="200" Height="150" Foreground="Green" Visibility="Collapsed"/>
                    </StackPanel>

                </StackPanel>
                <TextBox x:Name="LogTextBox" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
         Height="150" VerticalScrollBarVisibility="Auto"
         TextWrapping="Wrap" IsReadOnly="True"/>
            </Grid>
        </DockPanel>
    </Border>
</Window>
